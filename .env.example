# Copy to .env.local for local development. On Vercel, add these in Project Settings -> Environment Variables.
# Never commit real keys. The service-role key and OpenAI key are used only on the server.

# OpenAI (leave empty to run in offline mode: sample documents are read from known test values)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Supabase (Project Settings -> API). Leave empty to use a temporary in-memory store (local dev only).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Pause between stages in ms so a person can follow the live view (real durations are still recorded).
DEMO_PACING_MS=400

# Sign-in (required on Vercel; without them nobody can sign in). Never commit real values.
# SESSION_SECRET: any long random text, 32+ characters. DEMO_PASSWORD: the shared password for the 3 demo accounts (8+ characters).
SESSION_SECRET=
DEMO_PASSWORD=

# Optional: web address that receives each approved vendor record (JSON POST). Leave empty if there is no accounting system yet.
ACCOUNTING_WEBHOOK_URL=
