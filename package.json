{
  "name": "vendor-onboarding",
  "version": "1.0.0",
  "private": true,
  "description": "AI vendor onboarding and verification: submission to Approved / Pending / Rejected with traceable evidence.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/engine.test.ts tests/auth.test.ts",
    "e2e": "tsx scripts/scenarios-e2e.ts",
    "seed:sql": "tsx scripts/gen-seed.ts",
    "docs:samples": "tsx scripts/export-scenarios.ts && python3 scripts/make_documents.py && cp test-data/documents/* public/samples/"
  },
  "dependencies": {
    "@fontsource/open-sans": "^5.3.0",
    "@supabase/supabase-js": "^2.45.0",
    "next": "^15.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "server-only": "^0.0.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
